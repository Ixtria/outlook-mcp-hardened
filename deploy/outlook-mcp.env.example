# Environment file for outlook-mcp-hardened systemd service.
#
# Install :
#   sudo cp outlook-mcp.env.example /etc/outlook-mcp.env
#   sudo $EDITOR /etc/outlook-mcp.env       # fill in your values
#   sudo chown root:outlook-mcp /etc/outlook-mcp.env
#   sudo chmod 0640 /etc/outlook-mcp.env
#
# Permissions matter : root-owned, outlook-mcp-readable, world-blocked.
# The systemd unit references this file via EnvironmentFile=.

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — Azure App Registration
# ─────────────────────────────────────────────────────────────────────────

MS365_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS365_MCP_TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional — confidential client (most setups don't need this)
# MS365_MCP_CLIENT_SECRET=your-secret-here

# Optional — sovereign clouds
# MS365_MCP_CLOUD_TYPE=global    # default: global | gcc | gccHigh | china

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED for non-loopback HTTP bind (boot guards refuse to start otherwise)
# ─────────────────────────────────────────────────────────────────────────

# Public URL where this server is reached (used for OAuth discovery issuer).
# Must be https:// for non-loopback bind. RFC 8414 §2 + RFC 9728 §3.1.
OUTLOOK_MCP_PUBLIC_URL=https://outlook-mcp.example.com

# Comma-separated list of trusted reverse-proxy IPs. ONLY these IPs are
# trusted to set X-Forwarded-For / X-Forwarded-Proto. From any other peer,
# headers are ignored and the socket IP is used.
OUTLOOK_MCP_TRUSTED_PROXIES=127.0.0.1

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — CORS
# ─────────────────────────────────────────────────────────────────────────

# Default-deny CORS. Set to an exact origin (scheme://host[:port]) to allow.
# Wildcard '*' requires explicit OUTLOOK_MCP_CORS_ALLOW_WILDCARD=true (footgun).
# OUTLOOK_MCP_CORS_ORIGIN=https://your-app.example.com

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — write policy (default is read-only)
# ─────────────────────────────────────────────────────────────────────────

# Append these flags to the ExecStart in the unit file to enable writes :
#   --enable-send       Mail.Send + Mail.ReadWrite tools (compose, reply, forward, move, delete, drafts)
#   --enable-write      Calendars.ReadWrite tools (create/update/delete events, accept/decline meetings)
#
# Alternatively, env vars also work :
# OUTLOOK_MCP_ENABLE_SEND=1
# OUTLOOK_MCP_ENABLE_WRITE=1

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — rate limiting (http-public mode)
# ─────────────────────────────────────────────────────────────────────────

# Per-IP rate limit on /mcp endpoint. Default 100 req/min if unset.
# OUTLOOK_MCP_RATELIMIT_PER_MIN=100

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — log level (info | warn | error | debug)
# ─────────────────────────────────────────────────────────────────────────

LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────
# DO NOT SET in production
# ─────────────────────────────────────────────────────────────────────────

# OUTLOOK_MCP_AUDIT_SALT_HEX   — test-only override, refused at boot when
#                                NODE_ENV=production
